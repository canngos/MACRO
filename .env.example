OPENAI_API_KEY=your-api-key
# Select ollama, deepinfra or openai. Overrides IS_LOCAL_LLM when nonempty.
LLM_PROVIDER=ollama
# Legacy selection used only when LLM_PROVIDER is absent/blank.
IS_LOCAL_LLM=true
# Exact name from `ollama list`; required when local mode is true.
LOCAL_LLM_MODEL=
DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=Qwen/Qwen3.5-9B
